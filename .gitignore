### Node_Modules ###
node_modules

### CodeKit ###
# General CodeKit files to ignore
config.codekit3

### Hugo ###
# Generated files by hugo
/public/
/public
/public.nosync/
# 'public' is now a symlink to the non-synced build dir; ignore both forms.
# iCloud names a conflict copy "<name> 2", "<name> 3"... Those matched NEITHER
# rule above, so a conflict copy carrying files would have shown as untracked
# and could have been swept into a commit by `git add -A`. Empty ones are
# invisible to git, which is why this went unnoticed. Added 31 August 2026.
/public [0-9]*/
/public.nosync [0-9]*/
/resources/_gen/
/assets/jsconfig.json
hugo.log

# Temporary lock file while building
/.hugo_build.lock

### nova ###
.nova/*

### Obsidian ###
/content/articles/.obsidian

.DS_Store

# End of https://www.toptal.com/developers/gitignore/api/hugo,codekit,nova
